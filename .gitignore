# Python
**/__pycache__/
**/*.pyc
**/*.pyo

# Django
backend/db.sqlite3
backend/staticfiles/
backend/*.log

# Secrets — never commit
backend/.env
frontend/.env

# Frontend build
frontend/node_modules/
frontend/dist/

# Logs
*.log

# Python virtualenv
backend/.venv/

# Editor / local caches
.vscode/
frontend/.npm-cache/

# Use package-lock.json, not yarn
frontend/yarn.lock

# Local machine-specific Docker overrides (e.g. port conflicts)
docker-compose.override.yml
