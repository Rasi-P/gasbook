.neon
.vercel/
.secrets/
credentials.json
credentials.local.*
secrets.local.*
*.key
*.pem
*.p12
*.pfx

# Frontend build
frontend/node_modules/
frontend/dist/

# Logs
*.log

# macOS / editors
.DS_Store
.vscode/
.idea/

# Databases
*.sqlite3


