SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Local Postgres (with Docker Compose use: postgres://gasbook:gasbook123@db:5432/gasbook)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/gasbook
# Optional — enables the Redis cache + cached sessions (with Docker Compose use: redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0
# Optional receipt details; leave blank when unavailable.
RECEIPT_BUSINESS_ADDRESS=
RECEIPT_BUSINESS_PHONE=
RECEIPT_BUSINESS_EMAIL=
RECEIPT_BUSINESS_TAX_ID=

# Enable only after approval and application of core.0015_minimal_booking_inventory.
ACCESSORIES_ENABLED=False
